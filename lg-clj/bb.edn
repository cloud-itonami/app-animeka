{;; lg-animeka — clj-native port of the Python LangGraph server (ADR-2606280030).
 ;; Scoped to this app only (does NOT touch the repo-root bb.edn).
 ;;
 ;;   src   — lg-animeka.* namespaces (27 graphs + server + shared seams)
 ;;   test  — lg-animeka.smoke-test (clojure.test)
 ;;
 ;; Run the suite:  bb test   (or:  bb run_tests.clj)
 ;;
 ;; Pins match the wave-1 twins (etzhayyim-project-recap/lg-clj/bb.edn) so the
 ;; langgraph-clj StateGraph API is byte-identical across the migrated apps.
 :paths ["src" "test"]
 :deps {com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test {:doc "Run the clojure.test suite under bb."
        :task (load-file "run_tests.clj")}
  server {:doc "Start through the explicit Babashka host adapter."
          :task (apply shell "bb" "run_tests.clj" "--server" *command-line-args*)}}}
